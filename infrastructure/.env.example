# Merge these entries into infrastructure/.env; preserve existing Clerk settings.
# Enter secrets only in the ignored .env file, never in this template or frontend.
# Keep FAKE_EXTERNALS=1 until both keys are entered; change to 0 to enable real AI.
FAKE_EXTERNALS=0
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=famguard-vault
PINECONE_NAMESPACE=family-vault

# The index must use 1536 dimensions and cosine similarity (text-embedding-3-small).
# Local files remain on the shared Docker vault volume; email stays in Mailpit.
# Existing authentication settings, required for /api endpoints:
CLERK_JWKS_URL=
CLERK_ISSUER=
