# Copy to .env and fill in values. Never commit .env.

# --- Runtime ---
# ENV: dev | test | prod
ENV=dev
# RUN_MODE: api | worker | combined
RUN_MODE=api
PORT=8000
LOG_LEVEL=INFO
# FAKE_EXTERNALS=1 swaps OpenAI/Pinecone/R2/Resend for in-memory fakes (refused when ENV=prod)
FAKE_EXTERNALS=0

# --- Postgres (Supabase session pooler, port 5432) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/famguard
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/famguard

# --- Redis (Celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- OpenAI ---
OPENAI_API_KEY=

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX=famguard-vault
PINECONE_NAMESPACE=family-vault

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=famguard-vault

# --- Clerk ---
CLERK_JWKS_URL=
CLERK_ISSUER=
ALLOWED_ORIGINS=http://localhost:3000

# --- Resend ---
RESEND_API_KEY=
ALERT_FROM_EMAIL=

# --- Worker / cron ---
CELERY_TIMEZONE=UTC
CRON_SECRET=

# --- Frontend (Vercel) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
